{
  "name": "@snap-rail/suite-terminal-ops",
  "description": "The terminal-ops business suite: one package, one toggle — the whole renderer face of one industrial scenario (station layout + chrome + five process pages + counting settings) and its host-side shift counter (./stats, the durable production_stats store), snapRail.kind = suite",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/stats.js",
  "types": "lib/types/stats.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/stats.d.ts",
      "default": "./lib/stats.js"
    },
    "./stats": {
      "types": "./lib/types/stats.d.ts",
      "default": "./lib/stats.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "test": "vitest run",
    "pack": "snap-rail-plugin pack . --out dist"
  },
  "dependencies": {
    "@snap-rail/util": "^0.1.1",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@snap-rail/connection": "^0.1.0",
    "@snap-rail/cordis": "^4.0.1",
    "@snap-rail/cordis-plugin-timer": "^1.1.3",
    "@snap-rail/equipment": "^0.1.0",
    "@snap-rail/framework-shadcn": "^0.2.1",
    "@snap-rail/gateway": "^0.1.0",
    "@snap-rail/protocol": "^0.1.2",
    "@snap-rail/settings": "^0.1.0",
    "@snap-rail/shell": "^0.1.0",
    "@snap-rail/station-rpc": "^0.1.0",
    "@snap-rail/store": "^0.1.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@snap-rail/audit": "^0.1.0",
    "@snap-rail/client-kernel": "^0.1.1",
    "@snap-rail/connection": "^0.1.0",
    "@snap-rail/cordis": "^4.0.1",
    "@snap-rail/cordis-plugin-timer": "^1.1.3",
    "@snap-rail/equipment": "^0.1.0",
    "@snap-rail/framework-shadcn": "^0.2.1",
    "@snap-rail/gateway": "^0.1.0",
    "@snap-rail/plugin-kit": "^0.2.2",
    "@snap-rail/plugin-sdk": "^0.2.0",
    "@snap-rail/protocol": "^0.1.2",
    "@snap-rail/settings": "^0.1.0",
    "@snap-rail/shell": "^0.1.0",
    "@snap-rail/station-rpc": "^0.1.0",
    "@snap-rail/store": "^0.1.0",
    "@snap-rail/store-sqlite": "^0.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.14",
    "happy-dom": "^20.0.11",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "snapRail": {
    "kind": "suite",
    "layer": "suite",
    "exclusive": "suite",
    "category": "界面",
    "requires": [
      "@snap-rail/framework-shadcn@^0.2",
      "@snap-rail/equipment",
      "service:store",
      "service:shell"
    ],
    "client": {
      "entry": "lib-client/client.js",
      "surfaces": {
        "ball": "lib-client/ball.js",
        "panel": "lib-client/panel.js"
      }
    },
    "title": "生产作业套件"
  }
}

